#!/usr/bin/env ruby
# chsh-wrapper

# 20261111
# 0.3.1

require 'readline'

def list_of_system_shells
  File.readlines('/etc/shells', chomp: true)
    .reject{|line| line.start_with?('#') || line.strip.empty?}
    .map{|line| File.basename(line.strip)}
    .uniq
end

def extended_list_of_shell_paths
  @extended_list_of_shell_paths ||= (
    list_of_system_shells.flat_map do |shell|
      `which -a #{shell}`.split("\n").map(&:strip)
    end.uniq
  )
end

def shell_path_for(shell)
  extended_list_of_shell_paths.find{|shell_path| File.basename(shell_path) == shell}
end

def required_shell
  ARGV.first if ARGV.size == 1 && shell_path_for(ARGV.first)
end

def run_menu
  extended_list_of_shell_paths.each_with_index do |shell_path, index|
    puts "#{index}. #{shell_path}"
  end
  menu_number = Readline.readline('Shell #: ').to_s.strip
  if menu_number =~ /\A\d+\z/ && extended_list_of_shell_paths[menu_number.to_i]
    chsh(extended_list_of_shell_paths[menu_number.to_i])
  else
    abort("No shell numbered #{menu_number.inspect}.")
  end
end

def chsh(shell_path)
  command = ['sudo', 'chsh', '-s', shell_path, ENV['USER']]
  puts(command.join(' '))
  system(*command)
end

def main
  if ARGV.empty?
    run_menu
  elsif required_shell
    chsh(shell_path_for(required_shell))
  else
    exec('chsh', *ARGV)
  end
end

main
